[Unit]
Description=Hydroponic timelapse server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/timelapse/server
Environment=TIMELAPSE_DATA_DIR=/srv/timelapse
Environment=TIMELAPSE_ALLOWED_NETWORKS=127.0.0.0/8,192.168.0.0/16
Environment=TIMELAPSE_BIND_HOST=0.0.0.0
Environment=TIMELAPSE_PORT=8080
EnvironmentFile=-/etc/timelapse-server/server.env
ExecStart=/opt/timelapse/server/.venv/bin/uvicorn app.main:app --host ${TIMELAPSE_BIND_HOST} --port ${TIMELAPSE_PORT}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
