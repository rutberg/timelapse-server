# Copy this file to image/headless.env and edit before creating the SD-card image.
# Do not commit image/headless.env because it contains your Wi-Fi password.

TIMELAPSE_CAMERA_ID=tomatoes-zero-w
TIMELAPSE_SERVER_URL=http://<SERVER_IP>:8080

# Pi Zero W supports 2.4 GHz Wi-Fi only. Use a 2.4 GHz SSID or a mixed 2.4/5 GHz SSID.
TIMELAPSE_WIFI_SSID=YourWifiName
TIMELAPSE_WIFI_PSK=YourWifiPassword
TIMELAPSE_WIFI_COUNTRY=SE
TIMELAPSE_WIFI_HIDDEN=false

TIMELAPSE_CONFIG_POLL_SECONDS=60
TIMELAPSE_WORK_DIR=/var/lib/timelapse-agent

# Optional debugging access. Leave disabled for appliance mode.
TIMELAPSE_ENABLE_SSH=false

# Optional if enabling SSH. Generate a hash with:
# openssl passwd -6
# TIMELAPSE_USER=timelapse
# TIMELAPSE_PASSWORD_HASH=
