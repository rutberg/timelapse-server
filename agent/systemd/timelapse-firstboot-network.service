[Unit]
Description=Configure timelapse Wi-Fi on first boot
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service network-pre.target
Wants=network-pre.target
ConditionPathExists=/etc/timelapse-agent/headless.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/timelapse-firstboot-network

[Install]
WantedBy=sysinit.target
